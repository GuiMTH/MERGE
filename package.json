{
  "name": "@merge/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm depcruise",
    "depcruise": "node scripts/depcruise.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundaries": "node scripts/assert-fence-fails.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:boundaries && pnpm test",
    "demo": "tsx tools/demo/src/index.ts",
    "demo:artifact": "tsx tools/demo/src/index.ts --artifact"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
