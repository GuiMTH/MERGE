      "maxItems": 30,
      "type": "array",
    },
    "requisitos_evidencia": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mensagem_pretendida": {
            "description": "A afirmação que a peça pretende fazer, nas palavras do briefing.",
            "maxLength": 600,
            "minLength": 1,
            "type": "string",
          },
          "obrigatorio": {
            "description": "Se a peça não funciona sem esta afirmação.",
            "type": "boolean",
          },
          "tipo_evidencia_necessaria": {
            "description": "Que tipo de evidência sustentaria essa afirmação (desenho de estudo, desfecho, população).",
            "maxLength": 400,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "mensagem_pretendida",
          "tipo_evidencia_necessaria",
          "obrigatorio",
        ],
        "type": "object",
      },
      "maxItems": 50,
      "type": "array",
    },
    "score_completude": {
      "description": "0..1. Informação para o time, nunca critério de bloqueio de envio.",
      "maximum": 1,
      "minimum": 0,
      "type": "number",
    },
  },
  "required": [
    "score_completude",
    "lacunas",
    "requisitos_evidencia",
  ],
  "type": "object",
}
`;

exports[`JSON Schema dos contratos do §6 > 6.2 extração e ancoragem de claims 1`] = `
{
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ancoragem": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "pagina": {
                  "description": "Página onde a citação aparece, 1-based.",
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer",
                },
                "quote": {
                  "description": "Texto LITERAL presente no documento, copiado sem parafrasear, sem corrigir e sem elidir. Vai ser verificado por correspondência real contra o documento; paráfrase é rejeitada.",
                  "maxLength": 2000,
                  "minLength": 12,
                  "type": "string",
                },
                "referencia_id": {
                  "description": "O id da referência de onde o trecho foi tirado.",
                  "minLength": 1,
