            },
            "pagina": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
            "quote": {
              "description": "Texto LITERAL do label, verificado como qualquer outra citação.",
              "maxLength": 2000,
              "minLength": 12,
              "type": "string",
            },
          },
          "required": [
            "label_versao",
            "pagina",
            "quote",
          ],
          "type": "object",
        },
        {
          "type": "null",
        },
      ],
    },
  },
  "required": [
    "cobertura",
    "trecho_label",
    "justificativa",
    "requer_revisao_humana",
  ],
  "type": "object",
}
`;
