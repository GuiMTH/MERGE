                },
              },
              "required": [
                "referencia_id",
                "pagina",
                "quote",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "forca": {
            "description": "Força da evidência, 1..5, onde 1 é a MAIS forte (RCT head-to-head) e 5 a mais fraca (opinião/consenso).",
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
          },
          "requisito_atendido": {
            "description": "Qual requisito de evidência esta claim atende.",
            "minLength": 1,
            "type": "string",
          },
          "texto": {
            "description": "A afirmação, autocontida.",
            "maxLength": 1000,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "texto",
          "ancoragem",
          "forca",
          "requisito_atendido",
        ],
        "type": "object",
      },
      "maxItems": 60,
      "type": "array",
    },
    "gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "motivo": {
            "description": "Por que não foi possível produzir uma claim ancorada para este requisito.",
            "enum": [
              "sem_evidencia_no_acervo",
              "evidencia_insuficiente",
            ],
            "type": "string",
          },
          "requisito": {
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "requisito",
          "motivo",
        ],
        "type": "object",
      },
      "maxItems": 60,
      "type": "array",
    },
  },
  "required": [
    "claims",
    "gaps",
  ],
  "type": "object",
}
`;

exports[`JSON Schema dos contratos do §6 > 6.3 confronto com label 1`] = `
{
  "additionalProperties": false,
